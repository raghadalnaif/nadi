generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ───────── المنصة والأندية ─────────

// النادي = المستأجر (Tenant). كل البيانات مربوطة به.
model Club {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  address   String?
  vatNumber String? // الرقم الضريبي — يظهر في الفاتورة
  crNumber  String? // السجل التجاري
  createdAt DateTime @default(now())

  // اشتراك النادي في منصتنا (نحن مزود الحل)
  platformPlan    String   @default("basic") // basic | pro | enterprise
  platformFeeSAR  Float    @default(299)
  platformStatus  String   @default("active") // active | trial | suspended
  platformEndsAt  DateTime

  // طرق التحضير — المدير يفعّل ما يناسب ناديه
  checkinManual      Boolean @default(true)
  checkinBarcode     Boolean @default(true)
  checkinFingerprint Boolean @default(false)
  checkinWristband   Boolean @default(false)
  checkinGate        Boolean @default(false)
  blockExpiredEntry  Boolean @default(true)
  lastBackupAt       DateTime?

  // إعدادات واتساب
  waProvider    String  @default("link") // link = رابط يدوي | cloud_api = إرسال تلقائي
  waPhoneId     String? // معرّف رقم الواتساب في Meta
  waToken       String? // مفتاح الوصول
  waAutoWelcome Boolean @default(true)
  waAutoExpiry  Boolean @default(true)
  waExpiryDays  Int     @default(3)
  waAutoWinback Boolean @default(true)
  waAutoReceipt Boolean @default(true)

  // الموقع الجغرافي — للتحقق من حضور الموظفين داخل النطاق
  latitude        Float?
  longitude       Float?
  geofenceMeters  Int     @default(150)
  requireGeoStaff Boolean @default(false)

  users            User[]
  members          Member[]
  plans            Plan[]
  classes          GymClass[]
  invoices         Invoice[]
  expenses         Expense[]
  employees        Employee[]
  offers           Offer[]
  apiKeys          ApiKey[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  products         Product[]
  templates        MessageTemplate[]
  messages         Message[]
  leads            Lead[]
  branches         Branch[]
  shifts           CashShift[]
  announcements    Announcement[]
  platformInvoices PlatformInvoice[]
}

// فرع النادي — كل فرع بمشتركيه ودخله وحساباته
model Branch {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users     User[]
  members   Member[]
  employees Employee[]
  invoices  Invoice[]
  expenses  Expense[]
  classes   GymClass[]
  shifts    CashShift[]

  @@index([clubId, active])
}

// وردية الكاشير — فتح وتقفيل الصندوق
model CashShift {
  id              String    @id @default(cuid())
  clubId          String
  club            Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId          String
  userName        String
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  openingFloatSAR Float     @default(0) // العهدة الافتتاحية
  countedCashSAR  Float     @default(0) // النقد المعدود عند الإقفال
  expectedCashSAR Float     @default(0) // المتوقع من النظام
  varianceSAR     Float     @default(0) // الفرق (زيادة أو عجز)
  cardTotalSAR    Float     @default(0)
  otherTotalSAR   Float     @default(0)
  invoiceCount    Int       @default(0)
  note            String?
  status          String    @default("open") // open | closed

  @@index([clubId, status])
  @@index([clubId, openedAt])
}

// إعلان أو خطاب داخلي بين الإدارة والموظفين
model Announcement {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  branchId   String?
  title      String
  body       String
  kind       String   @default("announcement") // announcement | letter | policy
  audience   String   @default("all") // all | managers | department
  department String?
  authorId   String
  authorName String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  reads AnnouncementRead[]

  @@index([clubId, createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  userName       String
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

// التقييم السنوي للموظف
model Evaluation {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year        Int
  attendance  Int      @default(3) // 1-5
  performance Int      @default(3)
  teamwork    Int      @default(3)
  discipline  Int      @default(3)
  overall     Float    @default(3)
  notes       String?
  byName      String
  createdAt   DateTime @default(now())

  @@unique([employeeId, year])
}

// فاتورة اشتراك النادي في المنصة (إيرادنا نحن)
model PlatformInvoice {
  id        String    @id @default(cuid())
  clubId    String
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  month     String // YYYY-MM
  amountSAR Float
  status    String    @default("unpaid") // paid | unpaid
  issuedAt  DateTime  @default(now())
  paidAt    DateTime?

  @@unique([clubId, month])
}

// مفتاح API — يربط التطبيقات والأجهزة الخارجية بالنادي
model ApiKey {
  id         String    @id @default(cuid())
  clubId     String
  club       Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name       String // وصف الاستخدام: تطبيق الجوال، UrPass، جهاز البصمة…
  prefix     String // أول 8 أحرف للعرض في الواجهة
  keyHash    String    @unique // نخزّن الهاش فقط، المفتاح يُعرض مرة واحدة
  scopes     String    @default("read,write") // read | write | checkin
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  callCount  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([clubId, active])
}

// رمز دخول مؤقت للعضو — يُرسل لجواله بدل كلمة مرور دائمة
model OtpCode {
  id        String    @id @default(cuid())
  clubId    String
  phone     String // بصيغة دولية موحّدة
  codeHash  String // لا نخزّن الرمز نفسه
  purpose   String    @default("member_login")
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, expiresAt])
  @@index([clubId, createdAt])
}

// سجل التدقيق — من فعل ماذا ومتى. أساسي في نظام فيه أموال.
model AuditLog {
  id       String   @id @default(cuid())
  clubId   String? // null = إجراء على مستوى المنصة
  userId   String
  userName String
  action   String // create | update | delete | pay | suspend …
  entity   String // club | member | employee | plan | invoice …
  entityId String?
  summary  String // وصف عربي مقروء للإجراء
  at       DateTime @default(now())

  @@index([clubId, at])
}

// ───────── المستخدمون والصلاحيات ─────────

// الأدوار: super_admin (نحن) | owner | manager | accountant | hr | reception
model User {
  id           String   @id @default(cuid())
  clubId       String?
  club         Club?    @relation(fields: [clubId], references: [id])
  branchId     String? // مدير الفرع مقيّد بفرعه
  branch       Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberId     String?  @unique // حساب المشترك
  employeeId   String?  @unique // حساب الموظف
  name         String
  email        String   @unique
  passwordHash String
  role         String
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
}

// ───────── الأعضاء والاشتراكات ─────────

model Member {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  name      String
  phone     String
  memberNo  Int
  gender    String   @default("male")
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  barcode   String?  @unique
  notes     String?
  createdAt DateTime @default(now())

  subscriptions Subscription[]
  attendance    Attendance[]
  bookings      Booking[]
  invoices      Invoice[]
  messages      Message[]

  @@unique([clubId, memberNo])
  @@index([clubId, name])
  @@index([clubId, phone])
}

model Plan {
  id           String  @id @default(cuid())
  clubId       String
  club         Club    @relation(fields: [clubId], references: [id])
  name         String
  durationDays Int
  priceSAR     Float
  active       Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  paidSAR     Float
  discountSAR Float     @default(0)
  offerId     String?
  offer       Offer?    @relation(fields: [offerId], references: [id])
  status      String    @default("active") // active | frozen | cancelled
  frozenAt   DateTime?
  frozenDays Int       @default(0)
  source     String    @default("reception") // reception | app | urpass
  createdAt  DateTime  @default(now())

  invoices Invoice[]

  @@index([memberId, endsAt])
}

model Attendance {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkedAt DateTime @default(now())
  source    String   @default("reception") // reception | fingerprint | wristband | gate

  @@index([memberId, checkedAt])
}

// ───────── المنتجات ونقطة البيع ─────────

model Product {
  id         String  @id @default(cuid())
  clubId     String
  club       Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  category   String  @default("مكملات") // مكملات | ملابس | مشروبات | خدمات | أخرى
  priceSAR   Float // شامل الضريبة
  costSAR    Float   @default(0)
  stock      Int     @default(0)
  trackStock Boolean @default(true)
  active     Boolean @default(true)
  createdAt  DateTime @default(now())

  items InvoiceItem[]

  @@index([clubId, active])
}

// ───────── التواصل: قوالب ورسائل واتساب ─────────

model MessageTemplate {
  id        String  @id @default(cuid())
  clubId    String
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  key       String // welcome | expiry | post_sale | winback | receipt | custom
  name      String
  body      String // يدعم متغيرات مثل {الاسم} و{الباقة}
  active    Boolean @default(true)
  createdAt DateTime @default(now())

  messages Message[]

  @@unique([clubId, key])
}

model Message {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId   String?
  member     Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  toName     String
  phone      String
  body       String
  kind       String // welcome | expiry | post_sale | winback | receipt | manual
  status     String   @default("pending") // pending | sent | failed
  provider   String   @default("link") // link | cloud_api
  sentAt     DateTime?
  sentBy     String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([clubId, status])
  @@index([clubId, createdAt])
}

// ───────── العملاء المحتملون والمتابعة ─────────

model Lead {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  source     String   @default("زيارة") // زيارة | اتصال | إنستقرام | توصية | أخرى
  status     String   @default("new") // new | contacted | trial | converted | lost
  note       String?
  followUpAt DateTime?
  handledBy  String?
  createdAt  DateTime @default(now())

  @@index([clubId, status])
}

// ───────── العروض والخصومات ─────────

model Offer {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  name      String
  code      String
  kind      String   @default("percent") // percent = نسبة | fixed = مبلغ ثابت
  value     Float
  startsAt  DateTime
  endsAt    DateTime
  maxUses   Int      @default(0) // 0 = بلا حد
  usedCount Int      @default(0)
  active    Boolean  @default(true)
  planId    String? // null = يشمل كل الباقات
  createdAt DateTime @default(now())

  subscriptions Subscription[]

  @@unique([clubId, code])
  @@index([clubId, active])
}

// ───────── الحصص والحجوزات ─────────

model GymClass {
  id          String  @id @default(cuid())
  clubId      String
  club        Club    @relation(fields: [clubId], references: [id])
  branchId    String?
  branch      Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name        String
  coach       String
  durationMin Int
  capacity    Int

  sessions ClassSession[]
}

model ClassSession {
  id       String   @id @default(cuid())
  classId  String
  gymClass GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  startsAt DateTime
  capacity Int

  bookings Booking[]

  @@index([classId, startsAt])
}

model Booking {
  id        String       @id @default(cuid())
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    String       @default("booked") // booked | waitlist | cancelled | attended
  source    String       @default("reception") // app | reception | urpass
  createdAt DateTime     @default(now())

  @@unique([sessionId, memberId])
  @@index([sessionId, status])
}

// ───────── المحاسبة: دليل الحسابات والقيد المزدوج ─────────

model Account {
  id     String  @id @default(cuid())
  clubId String
  club   Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  code   String // 1010, 4010 …
  name   String
  type   String // asset | liability | equity | revenue | expense
  isCash Boolean @default(false) // حسابات النقد والبنك
  active Boolean @default(true)

  lines JournalLine[]

  @@unique([clubId, code])
  @@index([clubId, type])
}

// قيد اليومية — مجموع المدين = مجموع الدائن دائماً
model JournalEntry {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  number    Int // تسلسلي داخل النادي
  date      DateTime
  memo      String
  source    String // invoice | payment | expense | payroll | credit_note | manual
  refId     String? // معرّف المستند المصدر
  createdBy String?
  createdAt DateTime @default(now())

  lines JournalLine[]

  @@unique([clubId, number])
  @@index([clubId, date])
}

model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  debitSAR  Float        @default(0)
  creditSAR Float        @default(0)
  memo      String?

  @@index([accountId])
}

// ───────── الفواتير ─────────

model Invoice {
  id             String   @id @default(cuid())
  clubId         String
  club           Club     @relation(fields: [clubId], references: [id])
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberId       String?
  member         Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  number         String // رقم الفاتورة التسلسلي
  uuid           String   @default(cuid())
  issuedAt       DateTime @default(now())
  subtotalSAR    Float
  vatSAR         Float
  totalSAR       Float
  status         String   @default("paid") // paid | unpaid | refunded
  qrTLV          String? // رمز QR بصيغة ZATCA (TLV/Base64)

  // متطلبات الفوترة الإلكترونية — هيئة الزكاة والضريبة والدخل
  docType     String  @default("invoice") // invoice = فاتورة | credit_note = إشعار دائن
  refInvoiceId String? // الفاتورة الأصلية عند الإشعار الدائن
  invoiceType String  @default("simplified") // simplified = مبسطة (B2C) | standard = ضريبية (B2B)
  buyerName   String? // إلزامي في الفاتورة الضريبية B2B
  buyerVat    String? // الرقم الضريبي للمشتري
  icv         Int     @default(1) // العداد التسلسلي للفاتورة (Invoice Counter Value)
  pih         String? // هاش الفاتورة السابقة (Previous Invoice Hash) — سلسلة الترابط
  hash        String? // هاش هذه الفاتورة (SHA-256 من XML)
  xml         String? // مستند UBL 2.1

  items    InvoiceItem[]
  payments Payment[]

  @@unique([clubId, number])
  @@index([clubId, issuedAt])
}

model InvoiceItem {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description  String
  qty          Int     @default(1)
  unitPriceSAR Float
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method    String // cash | mada | visa | transfer | tabby | tamara
  amountSAR Float
  paidAt    DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category    String // رواتب | إيجار | صيانة | تسويق | مرافق | أخرى
  description String
  amountSAR   Float
  spentAt     DateTime @default(now())

  @@index([clubId, spentAt])
}

// ───────── الموارد البشرية ─────────

model Employee {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id])
  name       String
  jobTitle   String
  department String // إدارة | تدريب | استقبال | صيانة | محاسبة
  salarySAR  Float // الراتب الأساسي
  phone      String
  iban       String?
  barcode    String?  @unique
  hireDate   DateTime
  status     String   @default("active") // active | on_leave | terminated
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // بيانات التوظيف
  nationalId     String? // الهوية أو الإقامة
  nationality    String    @default("سعودي")
  contractType   String    @default("full_time") // full_time | part_time | temporary
  contractEndsAt DateTime?
  idExpiresAt    DateTime? // انتهاء الإقامة أو الهوية

  // هيكل الراتب — بدلات
  housingSAR    Float @default(0)
  transportSAR  Float @default(0)
  otherAllowSAR Float @default(0)

  // التأمينات الاجتماعية
  gosiSubject Boolean @default(true)

  // الدوام والإجازات
  shiftStart      String @default("08:00")
  shiftEnd        String @default("17:00")
  annualLeaveDays Int    @default(21)

  leaves      Leave[]
  payrolls    Payroll[]
  shifts      StaffAttendance[]
  evaluations Evaluation[]
}

model Leave {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String // سنوية | مرضية | اضطرارية | بدون راتب
  startsAt   DateTime
  endsAt     DateTime
  status      String   @default("pending") // pending | approved | rejected
  note        String?
  requestedBy String? // إن قدّمها الموظف بنفسه
  decidedBy   String?
  decidedAt   DateTime?
  decisionNote String?
  createdAt   DateTime @default(now())
}

model Payroll {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month         String // YYYY-MM
  baseSAR       Float
  housingSAR    Float     @default(0)
  transportSAR  Float     @default(0)
  otherAllowSAR Float     @default(0)
  overtimeSAR   Float     @default(0)
  bonusSAR      Float     @default(0)
  absenceSAR    Float     @default(0) // خصم الغياب
  gosiEmpSAR    Float     @default(0) // حصة الموظف من التأمينات
  gosiClubSAR   Float     @default(0) // حصة المنشأة
  deductionsSAR Float     @default(0)
  workedDays    Int       @default(0)
  absentDays    Int       @default(0)
  netSAR        Float
  status        String    @default("pending") // pending | paid
  paidAt        DateTime?

  @@unique([employeeId, month])
}

model StaffAttendance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  day        DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("present") // present | absent | leave

  // طريقة التسجيل والموقع
  method           String  @default("manual") // manual | barcode | kiosk
  checkInLat       Float?
  checkInLng       Float?
  checkInMeters    Float? // المسافة عن النادي
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutMeters   Float?
  outsideGeofence  Boolean @default(false)

  // الانضباط — تُحسب من وقت الدوام
  lateMinutes      Int @default(0)
  earlyLeaveMinutes Int @default(0)
  overtimeMinutes  Int @default(0) // present | absent | leave

  @@unique([employeeId, day])
}
