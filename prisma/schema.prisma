generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ───────── المنصة والأندية ─────────

// النادي = المستأجر (Tenant). كل البيانات مربوطة به.
model Club {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  phone     String?
  address   String?
  vatNumber String? // الرقم الضريبي — يظهر في الفاتورة
  crNumber  String? // السجل التجاري
  createdAt DateTime @default(now())

  // اشتراك النادي في منصتنا (نحن مزود الحل)
  platformPlan    String   @default("basic") // basic | pro | enterprise
  platformFeeSAR  Float    @default(299)
  platformStatus  String   @default("active") // active | trial | suspended
  platformEndsAt  DateTime

  // طرق التحضير — المدير يفعّل ما يناسب ناديه
  checkinManual      Boolean @default(true)
  checkinBarcode     Boolean @default(true)
  checkinFingerprint Boolean @default(false)
  checkinWristband   Boolean @default(false)
  checkinGate        Boolean @default(false)
  blockExpiredEntry  Boolean @default(true)
  lastBackupAt       DateTime?

  users            User[]
  members          Member[]
  plans            Plan[]
  classes          GymClass[]
  invoices         Invoice[]
  expenses         Expense[]
  employees        Employee[]
  offers           Offer[]
  apiKeys          ApiKey[]
  platformInvoices PlatformInvoice[]
}

// فاتورة اشتراك النادي في المنصة (إيرادنا نحن)
model PlatformInvoice {
  id        String    @id @default(cuid())
  clubId    String
  club      Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  month     String // YYYY-MM
  amountSAR Float
  status    String    @default("unpaid") // paid | unpaid
  issuedAt  DateTime  @default(now())
  paidAt    DateTime?

  @@unique([clubId, month])
}

// مفتاح API — يربط التطبيقات والأجهزة الخارجية بالنادي
model ApiKey {
  id         String    @id @default(cuid())
  clubId     String
  club       Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name       String // وصف الاستخدام: تطبيق الجوال، UrPass، جهاز البصمة…
  prefix     String // أول 8 أحرف للعرض في الواجهة
  keyHash    String    @unique // نخزّن الهاش فقط، المفتاح يُعرض مرة واحدة
  scopes     String    @default("read,write") // read | write | checkin
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  callCount  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([clubId, active])
}

// سجل التدقيق — من فعل ماذا ومتى. أساسي في نظام فيه أموال.
model AuditLog {
  id       String   @id @default(cuid())
  clubId   String? // null = إجراء على مستوى المنصة
  userId   String
  userName String
  action   String // create | update | delete | pay | suspend …
  entity   String // club | member | employee | plan | invoice …
  entityId String?
  summary  String // وصف عربي مقروء للإجراء
  at       DateTime @default(now())

  @@index([clubId, at])
}

// ───────── المستخدمون والصلاحيات ─────────

// الأدوار: super_admin (نحن) | owner | manager | accountant | hr | reception
model User {
  id           String   @id @default(cuid())
  clubId       String?
  club         Club?    @relation(fields: [clubId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         String
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
}

// ───────── الأعضاء والاشتراكات ─────────

model Member {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  name      String
  phone     String
  memberNo  Int
  gender    String   @default("male")
  barcode   String?  @unique
  notes     String?
  createdAt DateTime @default(now())

  subscriptions Subscription[]
  attendance    Attendance[]
  bookings      Booking[]
  invoices      Invoice[]

  @@unique([clubId, memberNo])
  @@index([clubId, name])
  @@index([clubId, phone])
}

model Plan {
  id           String  @id @default(cuid())
  clubId       String
  club         Club    @relation(fields: [clubId], references: [id])
  name         String
  durationDays Int
  priceSAR     Float
  active       Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  paidSAR     Float
  discountSAR Float     @default(0)
  offerId     String?
  offer       Offer?    @relation(fields: [offerId], references: [id])
  status      String    @default("active") // active | frozen | cancelled
  frozenAt   DateTime?
  frozenDays Int       @default(0)
  source     String    @default("reception") // reception | app | urpass
  createdAt  DateTime  @default(now())

  invoices Invoice[]

  @@index([memberId, endsAt])
}

model Attendance {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkedAt DateTime @default(now())
  source    String   @default("reception") // reception | fingerprint | wristband | gate

  @@index([memberId, checkedAt])
}

// ───────── العروض والخصومات ─────────

model Offer {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id])
  name      String
  code      String
  kind      String   @default("percent") // percent = نسبة | fixed = مبلغ ثابت
  value     Float
  startsAt  DateTime
  endsAt    DateTime
  maxUses   Int      @default(0) // 0 = بلا حد
  usedCount Int      @default(0)
  active    Boolean  @default(true)
  planId    String? // null = يشمل كل الباقات
  createdAt DateTime @default(now())

  subscriptions Subscription[]

  @@unique([clubId, code])
  @@index([clubId, active])
}

// ───────── الحصص والحجوزات ─────────

model GymClass {
  id          String @id @default(cuid())
  clubId      String
  club        Club   @relation(fields: [clubId], references: [id])
  name        String
  coach       String
  durationMin Int
  capacity    Int

  sessions ClassSession[]
}

model ClassSession {
  id       String   @id @default(cuid())
  classId  String
  gymClass GymClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  startsAt DateTime
  capacity Int

  bookings Booking[]

  @@index([classId, startsAt])
}

model Booking {
  id        String       @id @default(cuid())
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    String       @default("booked") // booked | waitlist | cancelled | attended
  source    String       @default("reception") // app | reception | urpass
  createdAt DateTime     @default(now())

  @@unique([sessionId, memberId])
  @@index([sessionId, status])
}

// ───────── المحاسبة ─────────

model Invoice {
  id             String   @id @default(cuid())
  clubId         String
  club           Club     @relation(fields: [clubId], references: [id])
  memberId       String?
  member         Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  number         String // رقم الفاتورة التسلسلي
  uuid           String   @default(cuid())
  issuedAt       DateTime @default(now())
  subtotalSAR    Float
  vatSAR         Float
  totalSAR       Float
  status         String   @default("paid") // paid | unpaid | refunded
  qrTLV          String? // رمز QR بصيغة ZATCA (TLV/Base64)

  // متطلبات الفوترة الإلكترونية — هيئة الزكاة والضريبة والدخل
  invoiceType String  @default("simplified") // simplified = مبسطة (B2C) | standard = ضريبية (B2B)
  buyerName   String? // إلزامي في الفاتورة الضريبية B2B
  buyerVat    String? // الرقم الضريبي للمشتري
  icv         Int     @default(1) // العداد التسلسلي للفاتورة (Invoice Counter Value)
  pih         String? // هاش الفاتورة السابقة (Previous Invoice Hash) — سلسلة الترابط
  hash        String? // هاش هذه الفاتورة (SHA-256 من XML)
  xml         String? // مستند UBL 2.1

  items    InvoiceItem[]
  payments Payment[]

  @@unique([clubId, number])
  @@index([clubId, issuedAt])
}

model InvoiceItem {
  id           String  @id @default(cuid())
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description  String
  qty          Int     @default(1)
  unitPriceSAR Float
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method    String // cash | mada | visa | transfer | tabby | tamara
  amountSAR Float
  paidAt    DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id])
  category    String // رواتب | إيجار | صيانة | تسويق | مرافق | أخرى
  description String
  amountSAR   Float
  spentAt     DateTime @default(now())

  @@index([clubId, spentAt])
}

// ───────── الموارد البشرية ─────────

model Employee {
  id         String   @id @default(cuid())
  clubId     String
  club       Club     @relation(fields: [clubId], references: [id])
  name       String
  jobTitle   String
  department String // إدارة | تدريب | استقبال | صيانة | محاسبة
  salarySAR  Float
  phone      String
  iban       String?
  barcode    String?  @unique
  hireDate   DateTime
  status     String   @default("active") // active | on_leave | terminated

  leaves   Leave[]
  payrolls Payroll[]
  shifts   StaffAttendance[]
}

model Leave {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String // سنوية | مرضية | اضطرارية | بدون راتب
  startsAt   DateTime
  endsAt     DateTime
  status     String   @default("pending") // pending | approved | rejected
  note       String?
}

model Payroll {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month         String // YYYY-MM
  baseSAR       Float
  bonusSAR      Float     @default(0)
  deductionsSAR Float     @default(0)
  netSAR        Float
  status        String    @default("pending") // pending | paid
  paidAt        DateTime?

  @@unique([employeeId, month])
}

model StaffAttendance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  day        DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("present") // present | absent | leave

  @@unique([employeeId, day])
}
